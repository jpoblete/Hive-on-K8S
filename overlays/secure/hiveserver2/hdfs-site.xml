<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
   <property>
      <name>dfs.nameservices</name>
      <value>nameservice</value>
   </property>
   <property>
      <name>dfs.ha.namenodes.nameservice</name>
      <value>nn1</value>
   </property>
   <property>
      <name>dfs.namenode.rpc-address.nameservice.nn1</name>
      <value>hadoop-namenode-0.hadoop-namenode-headless.secure.svc.cluster.local:8020</value>
   </property>
   <property>
      <name>dfs.namenode.kerberos.principal.nameservice.nn1</name>
      <value>hdfs/hadoop-namenode-0.hadoop-namenode-headless.secure.svc.cluster.local@SECURE.LAB</value>
   </property>
   <property>
      <name>dfs.client.failover.proxy.provider.nameservice</name>
      <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
   </property>
   <property>
      <name>dfs.namenode.kerberos.principal</name>
      <value>hdfs/hadoop-namenode-0.hadoop-namenode-headless.secure.svc.cluster.local@SECURE.LAB</value>
   </property>
   <property>
      <name>dfs.block.access.token.enable</name>
      <value>true</value>
   </property>
   <property>
      <name>dfs.data.transfer.protection</name>
      <value>authentication</value>
   </property>
   <property>
      <name>dfs.encrypt.data.transfer</name>
      <value>false</value>
   </property>
</configuration>
